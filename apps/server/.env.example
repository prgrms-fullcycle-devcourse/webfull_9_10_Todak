# ─── Server ───────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# ─── Database (Supabase PostgreSQL) ──────────────────────
# 앱/Prisma CLI 공통 (Connection pooling URL 권장)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"
# 마이그레이션 전용 Direct URL (선택, prisma migrate 시 pooler 오류 나면 사용)
# DIRECT_DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# ─── Redis (Railway) ──────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── GitHub OAuth & API ───────────────────────────────────
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_CALLBACK_URL=http://localhost:4000/api/auth/github/callback

# ─── Anthropic ────────────────────────────────────────────
ANTHROPIC_API_KEY=your-anthropic-api-key

# ─── JWT ──────────────────────────────────────────────────
JWT_SECRET=your-jwt-secret-min-32-chars
JWT_EXPIRES_IN=7d

# ─── CORS ─────────────────────────────────────────────────
CLIENT_URL=http://localhost:3000

# ─── AWS S3 (채팅 첨부 이미지/PDF 저장) ────────────────────
# 전용 IAM 사용자의 액세스 키 (S3 PutObject/GetObject 권한)
AWS_REGION=ap-northeast-2
S3_BUCKET=team03-s3-chat-attachments
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
